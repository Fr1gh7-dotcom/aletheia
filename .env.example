# Aletheia — variabili d'ambiente
# Copiare in .env.local e riempire dopo aver creato il progetto Supabase (regione EU).

# --- Supabase (obbligatorie per far comparire i dati) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solo per gli script di import (scripts/) — NON esporre al client ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Solo per `npm run db:migrate` (applica supabase/migrations/ via Management API) ---
# Personal Access Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Import Kiel (opzionali) ---
# Data "as of" da attribuire ai flussi Kiel (default 2026-06-30)
# KIEL_AS_OF=2026-06-30
# Fattore per convertire l'unità del foglio in euro (default 1e9 = miliardi)
# KIEL_UNIT_FACTOR=1000000000
